<html>
<head>
<title>ClusterSamplePortlet</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ClusterSamplePortlet</td></tr>
</thead>

<tbody>
<tr>
	<td>NO_SESSION_DATA_MESSAGE</td>
	<td>//div[@class='portlet-body']//p[contains(.,'No session data exists, generating a new one with random string:')]</td>
	<td></td>
</tr>
<tr>
	<td>STORED_DATA</td>
	<td>//div[@class='portlet-body']/ul/li[contains(.,'Stored Data')]</td>
	<td></td>
</tr>
<tr>
	<td>LOGGED_IN_SESSIONS</td>
	<td>//div[@class='logged-in-sessions']</td>
	<td></td>
</tr>
<tr>
	<td>ALL_SESSION_IDS</td>
	<td>//div[@class='all-session-ids']</td>
	<td></td>
</tr>
<tr>
	<td>ALL_SESSION_IDS_CONTAINS_GUEST_SESSION_ID</td>
	<td>//div[@class='all-session-ids'][contains(., '${guestSessionId}')]</td>
	<td></td>
</tr>
<tr>
	<td>CURRENT_SESSION_ID</td>
	<td>//p[@class='current-session-id']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>