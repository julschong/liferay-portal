<div class="float-right">

	<%
	String updateLanguageFormAction = URLBuilder.create(
		themeDisplay.getPathMain() + "/portal/update_language"
	).addParameter(
		"p_l_id", themeDisplay.getPlid()
	).build();

	String updateLanguageRedirect = URLBuilder.create(
		PortalUtil.getCurrentURL(request)
	).addParameter(
		"ticketKey", ParamUtil.getString(request, "ticketKey")
	).build();

	updateLanguageFormAction = URLBuilder.create(
		updateLanguageFormAction
	).addParameter(
		"redirect", updateLanguageRedirect
	).build();
	%>

	<liferay-ui:language
		formAction="<%= updateLanguageFormAction %>"
		languageId="<%= themeDisplay.getLanguageId() %>"
		languageIds="<%= LocaleUtil.toLanguageIds(LanguageUtil.getAvailableLocales(themeDisplay.getSiteGroupId())) %>"
	/>
</div>